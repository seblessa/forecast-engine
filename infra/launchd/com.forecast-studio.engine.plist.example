<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.forecast-studio.engine</string>
  <key>ProgramArguments</key>
  <array>
    <string>&lt;REPO_ROOT&gt;/infra/launchd/start-engine.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>&lt;REPO_ROOT&gt;</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>&lt;USER_HOME&gt;/Library/Logs/forecast-studio-engine.log</string>
  <key>StandardErrorPath</key>
  <string>&lt;USER_HOME&gt;/Library/Logs/forecast-studio-engine.error.log</string>
</dict>
</plist>
