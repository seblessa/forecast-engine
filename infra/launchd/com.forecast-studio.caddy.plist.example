<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.forecast-studio.caddy</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/caddy</string>
    <string>run</string>
    <string>--config</string>
    <string>&lt;REPO_ROOT&gt;/infra/Caddyfile</string>
    <string>--adapter</string>
    <string>caddyfile</string>
  </array>
  <key>WorkingDirectory</key>
  <string>&lt;REPO_ROOT&gt;</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>&lt;USER_HOME&gt;/Library/Logs/forecast-studio-caddy.log</string>
  <key>StandardErrorPath</key>
  <string>&lt;USER_HOME&gt;/Library/Logs/forecast-studio-caddy.error.log</string>
</dict>
</plist>
